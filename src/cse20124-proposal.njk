<style>
/* ============================================================
   Five-column comparison layout
     col 1  — current schedule (CSE 30124, reference)
     col 2-4 — rationale paragraphs
     col 5  — proposed schedule (CSE 20124, recommended)
   ============================================================ */
.compare-grid {
    display: grid;
    grid-template-columns: 1.8fr 1.05fr 1.05fr;
    gap: 22px 60px;
    align-items: start;
    margin-bottom: 28px;
    position: relative;
}
.compare-col {
    min-width: 0;
}

/* Split-lecture connector arrows (drawn by the script as an SVG overlay
   in the channel between the two schedules). */
.split-arrows {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: none;
    overflow: visible;
    z-index: 3;
}
.split-arrow {
    fill: none;
    transition: opacity 120ms ease;
}
.split-arrows.is-dimmed .split-arrow:not(.is-active) {
    opacity: 0.08;
}
.split-arrow.is-active {
    stroke-width: 2.4px;
    stroke-opacity: 1;
}

/* Curly brace wrapping each rationale block, prong pointing toward
   the schedule region it applies to (drawn by the script). */
.rationale-brace {
    fill: none;
    stroke: rgba(0, 43, 92, 0.38);
    stroke-width: 1.5px;
    stroke-linecap: round;
}
/* Connector from a rationale brace to the requirement block it discusses. */
.req-connector {
    fill: none;
    stroke: rgba(0, 43, 92, 0.4);
    stroke-width: 1.5px;
    stroke-linecap: round;
}
/* Thin separators between rationale blocks (wide layout, drawn in SVG). */
.rationale-sep {
    stroke: #d6d6d6;
    stroke-width: 1px;
}

/* Endpoint dots in the lecture title cells (added by the script).
   Sit above the arrow overlay so the lines terminate cleanly. */
.split-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    position: relative;
    z-index: 4;
    box-shadow: 0 0 0 1.5px #fff;
}
.split-dot--target {
    margin-right: 5px;
    vertical-align: middle;
}
.split-dot--source {
    position: absolute;
    right: 7px;
    top: 50%;
    transform: translateY(-50%);
}
/* Reserve room on the right of source titles for the dot. */
.schedule-panel .table tr[data-split] td:last-child {
    position: relative;
    padding-right: 22px;
}

/* Prerequisite note above the proposed schedule. */
.prereq-note {
    padding: 8px 12px 9px;
    margin-bottom: 12px;
    background: #fbf7ec;
    border: 1px solid #d8cda8;
    border-left: 3px solid #b18d03;
    border-radius: 2px;
    line-height: 1.3;
}
.prereq-note__row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
}
.prereq-note__tag {
    flex-shrink: 0;
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 800;
    color: #002148;
    background: #b18d03;
    border-radius: 2px;
    padding: 3px 7px 2px;
}
.prereq-note__code {
    font-weight: 700;
    color: #002b5c;
    font-size: 0.86rem;
    font-variant-numeric: tabular-nums;
}
.prereq-note__title {
    color: #2d2a22;
    font-size: 0.8rem;
}

/* Rows that participate in a split highlight on hover. */
.schedule-panel .table tr[data-split],
.schedule-panel .table tr[data-split-to] {
    cursor: default;
}
.schedule-panel .table tr.is-split-active td {
    background-color: rgba(177, 141, 3, 0.14);
}

/* Rationale — one block spanning the left three columns; the current
   and proposed schedules sit side by side in the rightmost two.
   Plain in-page text with navy heads like the rest of the site
   (gold reserved for accents, never headings). */
.rationale-col {
    line-height: 1.6;
}
.rationale-col__head {
    margin: 0 0 10px;
    font-size: 1.55rem;
    font-weight: 600;
    color: #002b5c;
}
.rationale-col p {
    font-size: 1.35rem;
    margin-bottom: 0;
}
/* When stacked (narrow / no-JS) the blocks flow with spacing; on wide
   screens the alignment script positions them absolutely instead. */
.rationale-block + .rationale-block {
    margin-top: 26px;
}

/* Two-column "must have / nice to have" topic list inside a rationale block. */
.rationale-topics {
    margin-top: 16px;
}
.rationale-topics__label {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #b18d03;
    margin-bottom: 8px;
}
.topic-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px 22px;
}
.topic-col__head {
    font-size: 1.05rem;
    font-weight: 600;
    color: #002b5c;
    margin-bottom: 5px;
    padding-bottom: 3px;
    border-bottom: 1px solid #e2dcc8;
}
.topic-col ul {
    margin: 0;
    padding-left: 1.2em;
    font-size: 1rem;
    line-height: 1.5;
}
.topic-col li {
    margin-bottom: 2px;
}

@media (max-width: 1100px) {
    .compare-grid {
        grid-template-columns: 1fr 1fr;
        gap: 22px;
    }
    .rationale-col {
        grid-column: 1 / 3;
    }
    .rationale-col p {
        max-width: 70ch;
    }
    .rationale-block + .rationale-block {
        border-top: 1px solid #d6d6d6;
        padding-top: 24px;
    }
}
@media (max-width: 680px) {
    .compare-grid {
        grid-template-columns: 1fr;
    }
    .rationale-col {
        grid-column: auto;
    }
}

/* ============================================================
   Schedule panels — old (reference) vs new (recommended)
   ============================================================ */
.schedule-panel {
    border-top: 4px solid #b18d03 !important;
    border-top-left-radius: 0 !important;
    border-top-right-radius: 0 !important;
    position: relative;
    box-shadow: 0 1px 2px rgba(0, 43, 92, 0.06);
}
/* The current schedule is reference material — muted rail, not gold. */
.schedule-panel--reference {
    border-top-color: #b6ac8c !important;
}
.schedule-panel > .panel-heading {
    position: relative;
}
.schedule-panel__meta {
    display: block;
    margin-top: 4px;
    font-variant-numeric: tabular-nums;
}
.schedule-panel .table {
    font-size: 0.78rem;
    margin-bottom: 0;
}
.schedule-panel .table td:first-child,
.schedule-panel .table th:first-child {
    white-space: nowrap;
    width: 1%;
    text-align: center;
}

/* Dropped lectures (GOFAI) in the current schedule */
.schedule-panel .table tr.is-dropped td {
    background-color: rgba(220, 53, 69, 0.13);
    color: #9b2c34;
    text-decoration: line-through;
}
.schedule-panel .table tr.is-dropped td.text-muted {
    color: #c58b91;
}

/* Small badge in a schedule heading. */
.schedule-chip {
    display: inline-block;
    margin-left: 6px;
    vertical-align: 2px;
    background: #b18d03;
    color: #002148;
    border: 1px solid #8a6e02;
    padding: 3px 8px 2px;
    border-radius: 2px;
    font-weight: 700;
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    box-shadow: 0 1px 2px rgba(0, 43, 92, 0.18);
    font-family: inherit;
}
.schedule-chip--muted {
    background: #ece4cd;
    color: #6a5d33;
    border-color: #cdc098;
    box-shadow: none;
}

/* ============================================================
   Intro lead + recommendation callout
   ============================================================ */
.proposal-intro {
    margin-bottom: 22px;
    line-height: 1.6;
}
.proposal-intro > p {
    max-width: 80ch;
    margin-bottom: 0;
}

.proposal-recommendation {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 26px;
    padding: 14px 18px;
    background: #002b5c;
    border-radius: 2px;
    box-shadow: 0 4px 14px rgba(0, 43, 92, 0.28);
}
.proposal-recommendation__tag {
    flex-shrink: 0;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 800;
    color: #002148;
    background: #b18d03;
    border-radius: 2px;
    padding: 4px 9px 3px;
}
.proposal-recommendation__body {
    margin: 0;
    color: #fff;
    font-size: 15px;
    line-height: 1.45;
}
.proposal-recommendation__body strong {
    color: #e0b431;
}

/* ============================================================
   Legend
   ============================================================ */
.schedule-legend {
    margin-bottom: 18px;
}
.schedule-legend .label {
    margin-right: 4px;
}
</style>

