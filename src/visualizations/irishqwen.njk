o\" data-go=\"linear_layer.py:60:90\" title=\"Go to LinearLayer.backward (linear_layer.py)\">backward<\/a>(dY)                          <span class=\"tc\"># (B, T, F)<\/span>", "", "        <span class=\"tc\"># Elementwise gate:  H = g * u<\/span>", "        dg <span class=\"to\">=<\/span> dH <span class=\"to\">*<\/span> <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>u", "        du <span class=\"to\">=<\/span> dH <span class=\"to\">*<\/span> <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>g", "", "        <span class=\"tc\"># X fed both branches, so its gradient is the sum of both<\/span>", "        dX <span class=\"to\">=<\/span> <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>gate<span class=\"to\">.<\/span><a class=\"go\" data-go=\"linear_layer.py:60:90\" title=\"Go to LinearLayer.backward (linear_layer.py)\">backward<\/a>(<span class=\"tp\">self<\/span><span class=\"to\">.<\/span>act<span class=\"to\">.<\/span><a class=\"go\" data-go=\"silu.py:15:19\" title=\"Go to SiLU.backward (silu.py)\">backward<\/a>(dg)) <span class=\"to\">+<\/span> <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>up<span class=\"to\">.<\/span><a class=\"go\" data-go=\"linear_layer.py:60:90\" title=\"Go to LinearLayer.backward (linear_layer.py)\">backward<\/a>(du)", "        <span class=\"tk\">return<\/span> dX", "", "    <span class=\"tk\">def<\/span> <span class=\"tf\">update<\/span>(<span class=\"tp\">self<\/span>, lr):", "        <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>gate<span class=\"to\">.<\/span><a class=\"go\" data-go=\"linear_layer.py:92:106\" title=\"Go to LinearLayer.update (linear_layer.py)\">update<\/a>(lr)", "        <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>up<span class=\"to\">.<\/span><a class=\"go\" data-go=\"linear_layer.py:92:106\" title=\"Go to LinearLayer.update (linear_layer.py)\">update<\/a>(lr)", "        <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>down<span class=\"to\">.<\/span><a class=\"go\" data-go=\"linear_layer.py:92:106\" title=\"Go to LinearLayer.update (linear_layer.py)\">update<\/a>(lr)", "", "    <span class=\"tk\">def<\/span> <span class=\"tf\">load_from_qwen3_tensors<\/span>(<span class=\"tp\">self<\/span>, gate_proj, up_proj, down_proj):", "        <span class=\"tc\"># HF nn.Linear weights are already (out, in) == LinearLayer.W. No transpose!<\/span>", "        <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>gate<span class=\"to\">.<\/span>W <span class=\"to\">=<\/span> gate_proj<span class=\"to\">.<\/span>to(<span class=\"tp\">self<\/span><span class=\"to\">.<\/span>device)<span class=\"to\">.<\/span>contiguous()", "        <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>up<span class=\"to\">.<\/span>W <span class=\"to\">=<\/span> up_proj<span class=\"to\">.<\/span>to(<span class=\"tp\">self<\/span><span class=\"to\">.<\/span>device)<span class=\"to\">.<\/span>contiguous()", "        <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>down<span class=\"to\">.<\/span>W <span class=\"to\">=<\/span> down_proj<span class=\"to\">.<\/span>to(<span class=\"tp\">self<\/span><span class=\"to\">.<\/span>device)<span class=\"to\">.<\/span>contiguous()"], "stubs": [], "outline": [{"label": "SwiGLU", "type": "class", "parent": null, "depth": 0, "start": 5, "end": 52}, {"label": "__init__", "type": "method", "parent": "SwiGLU", "depth": 1, "start": 18, "end": 24}, {"label": "forward", "type": "method", "parent": "SwiGLU", "depth": 1, "start": 26, "end": 30}, {"label": "backward", "type": "method", "parent": "SwiGLU", "depth": 1, "start": 32, "end": 41}, {"label": "update", "type": "method", "parent": "SwiGLU", "depth": 1, "start": 43, "end": 46}, {"label": "load_from_qwen3_tensors", "type": "method", "parent": "SwiGLU", "depth": 1, "start": 48, "end": 52}]}, "silu.py": {"html": ["<span class=\"tk\">import<\/span> torch", "", "", "<span class=\"tk\">class<\/span> <span class=\"tf\">SiLU<\/span>:", "    <span class=\"td\">\"\"\"<\/span>", "<span class=\"td\">    SiLU / \"Swish\" activation: x * sigmoid(x).<\/span>", "<span class=\"td\">    This is the activation inside SwiGLU (Llama, Qwen, Mistral, ...).<\/span>", "<span class=\"td\">    \"\"\"<\/span>", "", "    <span class=\"tk\">def<\/span> <span class=\"tf\">forward<\/span>(<span class=\"tp\">self<\/span>, X):", "        <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>X <span class=\"to\">=<\/span> X", "        <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>sig <span class=\"to\">=<\/span> torch<span class=\"to\">.<\/span>sigmoid(X)", "        <span class=\"tk\">return<\/span> X <span class=\"to\">*<\/span> <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>sig", "", "    <span class=\"tk\">def<\/span> <span class=\"tf\">backward<\/span>(<span class=\"tp\">self<\/span>, dA):", "        <span class=\"tc\"># d/dx [x * s(x)] = s(x) + x * s(x) * (1 - s(x))<\/span>", "        x <span class=\"to\">=<\/span> <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>X", "        dsilu_dx <span class=\"to\">=<\/span> <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>sig <span class=\"to\">*<\/span> (<span class=\"tn\">1.0<\/span> <span class=\"to\">+<\/span> x <span class=\"to\">*<\/span> (<span class=\"tn\">1.0<\/span> <span class=\"to\">-<\/span> <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>sig))", "        <span class=\"tk\">return<\/span> dA <span class=\"to\">*<\/span> dsilu_dx", "", "    <span class=\"tk\">def<\/span> <span class=\"tf\">update<\/span>(<span class=\"tp\">self<\/span>, lr):", "        <span class=\"tc\"># Activation layer has no trainable parameters.<\/span>", "        <span class=\"tk\">pass<\/span>"], "stubs": [], "outline": [{"label": "SiLU", "type": "class", "parent": null, "depth": 0, "start": 4, "end": 23}, {"label": "forward", "type": "method", "parent": "SiLU", "depth": 1, "start": 10, "end": 13}, {"label": "backward", "type": "method", "parent": "SiLU", "depth": 1, "start": 15, "end": 19}, {"label": "update", "type": "method", "parent": "SiLU", "depth": 1, "start": 21, "end": 23}]}, "linear_layer.py": {"html": ["<span class=\"tk\">import<\/span> math", "<span class=\"tk\">import<\/span> torch", "", "<span class=\"tc\"># TODO: Implement the LinearLayer class (Consider copying from Homework04)<\/span>", "", "<span class=\"tk\">class<\/span> <span class=\"tf\">LinearLayer<\/span>:", "    <span class=\"td\">\"\"\"<\/span>", "<span class=\"td\">    A fully connected (dense) layer that performs a linear transformation.<\/span>", "", "<span class=\"td\">    Attributes:<\/span>", "<span class=\"td\">        W (torch.Tensor): Weight matrix with shape (output_dim, input_dim).<\/span>", "<span class=\"td\">        b (torch.Tensor): Bias vector with shape (output_dim, 1).<\/span>", "<span class=\"td\">        X (torch.Tensor): Cached input used during the forward pass.<\/span>", "<span class=\"td\">        dW (torch.Tensor): Gradient with respect to the weights.<\/span>", "<span class=\"td\">        db (torch.Tensor): Gradient with respect to the biases.<\/span>", "<span class=\"td\">    \"\"\"<\/span>", "    <span class=\"tk\">def<\/span> <span class=\"tf\">__init__<\/span>(<span class=\"tp\">self<\/span>, input_dim, output_dim, device<span class=\"to\">=<\/span><span class=\"ts\">'<\/span><span class=\"ts\">cpu<\/span><span class=\"ts\">'<\/span>, bias<span class=\"to\">=<\/span><span class=\"tk\">True<\/span>):", "        <span class=\"td\">\"\"\"<\/span>", "<span class=\"td\">        Initialize the LinearLayer with random weights and biases using He initialization.<\/span>", "", "<span class=\"td\">        Args:<\/span>", "<span class=\"td\">            input_dim (int): Dimension of the input features.<\/span>", "<span class=\"td\">            output_dim (int): Number of neurons (output features).<\/span>", "<span class=\"td\">            bias (bool): If False, the layer has no bias (b is None). Qwen/Llama use no biases.<\/span>", "", "<span class=\"td\">        Returns:<\/span>", "<span class=\"td\">            None<\/span>", "", "<span class=\"td\">        Notes:<\/span>", "<span class=\"td\">            Weights and biases are initialized from a normal distribution and scaled by sqrt(2/input_dim) (He initialization).<\/span>", "<span class=\"td\">        \"\"\"<\/span>", "        <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>device <span class=\"to\">=<\/span> device", "", "        <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>W <span class=\"to\">=<\/span> torch<span class=\"to\">.<\/span>randn(output_dim, input_dim, device<span class=\"to\">=<\/span><span class=\"tp\">self<\/span><span class=\"to\">.<\/span>device) <span class=\"to\">*<\/span> math<span class=\"to\">.<\/span>sqrt(<span class=\"tn\">2.0<\/span> <span class=\"to\">/<\/span> input_dim)", "        <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>b <span class=\"to\">=<\/span> torch<span class=\"to\">.<\/span>randn(<span class=\"tn\">1<\/span>, output_dim, device<span class=\"to\">=<\/span><span class=\"tp\">self<\/span><span class=\"to\">.<\/span>device) <span class=\"to\">*<\/span> math<span class=\"to\">.<\/span>sqrt(<span class=\"tn\">2.0<\/span> <span class=\"to\">/<\/span> input_dim) <span class=\"tk\">if<\/span> bias <span class=\"tk\">else<\/span> <span class=\"tk\">None<\/span>", "", "    <span class=\"tk\">def<\/span> <span class=\"tf\">forward<\/span>(<span class=\"tp\">self<\/span>, X):", "        <span class=\"td\">\"\"\"<\/span>", "<span class=\"td\">        Compute the forward pass of the linear layer.<\/span>", "", "<span class=\"td\">        Args:<\/span>", "<span class=\"td\">            X (torch.Tensor): Input data with shape (input_dim, m) where m is the number of examples.<\/span>", "", "<span class=\"td\">        Returns:<\/span>", "<span class=\"td\">            Z (torch.Tensor): Linear output with shape (output_dim, m)<\/span>", "", "<span class=\"td\">        Notes:<\/span>", "<span class=\"td\">            The input X is stored for use during backpropagation.<\/span>", "<span class=\"td\">        \"\"\"<\/span>", "", "        <span class=\"tc\"># TODO: Store the input and calculate the output of the linear layer<\/span>", "        <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>X <span class=\"to\">=<\/span> X", "", "        Z <span class=\"to\">=<\/span> X <span class=\"to\">@<\/span> <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>W<span class=\"to\">.<\/span>T", "        <span class=\"tk\">if<\/span> <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>b <span class=\"to\">is<\/span> <span class=\"to\">not<\/span> <span class=\"tk\">None<\/span>:", "            Z <span class=\"to\">=<\/span> Z <span class=\"to\">+<\/span> <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>b", "", "        <span class=\"tk\">return<\/span> Z", "", "    <span class=\"tk\">def<\/span> <span class=\"tf\">backward<\/span>(<span class=\"tp\">self<\/span>, dY):", "        <span class=\"td\">\"\"\"<\/span>", "<span class=\"td\">        Compute the backward pass of the linear layer.<\/span>", "", "<span class=\"td\">        Args:<\/span>", "<span class=\"td\">            dY (torch.Tensor): Gradient with respect to the output of the linear layer (batch_size, sequence_length, output_dim)<\/span>", "", "<span class=\"td\">        Returns:<\/span>", "<span class=\"td\">            dX (torch.Tensor): Gradient with respect to the input of the linear layer (batch_size, sequence_length, input_dim)<\/span>", "", "<span class=\"td\">        Notes:<\/span>", "<span class=\"td\">            This is trickier than in Homework 04 because our input is now 3D (batch_size, sequence_length, input_dim)<\/span>", "<span class=\"td\">            To calculate dW we use a similar idea to im2col and flatten the input matrix across the batch_size and sequence_length dimensions.<\/span>", "<span class=\"td\">            We then do the same thing for X and then can use a simple 2D matmul to calculate dW directly.<\/span>", "<span class=\"td\">        \"\"\"<\/span>", "", "        <span class=\"tc\"># dY_flat shape: (batch_size * sequence_length, output_dim)<\/span>", "        dY_flat <span class=\"to\">=<\/span> dY<span class=\"to\">.<\/span>reshape(<span class=\"to\">-<\/span><span class=\"tn\">1<\/span>, dY<span class=\"to\">.<\/span>shape[<span class=\"to\">-<\/span><span class=\"tn\">1<\/span>])", "", "        <span class=\"tc\"># X_flat shape: (batch_size * sequence_length, input_dim)<\/span>", "        X_flat  <span class=\"to\">=<\/span> <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>X<span class=\"to\">.<\/span>reshape(<span class=\"to\">-<\/span><span class=\"tn\">1<\/span>, <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>X<span class=\"to\">.<\/span>shape[<span class=\"to\">-<\/span><span class=\"tn\">1<\/span>])", "", "        <span class=\"tc\"># dW shape: (output_dim, input_dim)<\/span>", "        <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>dW <span class=\"to\">=<\/span> dY_flat<span class=\"to\">.<\/span>T <span class=\"to\">@<\/span> X_flat", "", "        <span class=\"tk\">if<\/span> <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>b <span class=\"to\">is<\/span> <span class=\"to\">not<\/span> <span class=\"tk\">None<\/span>:", "            <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>db <span class=\"to\">=<\/span> dY<span class=\"to\">.<\/span>sum(dim<span class=\"to\">=<\/span>(<span class=\"tn\">0<\/span>, <span class=\"tn\">1<\/span>))  <span class=\"tc\"># (Out,)<\/span>", "", "        dX <span class=\"to\">=<\/span> dY <span class=\"to\">@<\/span> <span class=\"tp\">self<\/span><span class=\"to\">.<\/span>W  <span class=\"tc\"># (B, T, In) because (B,T,Out) @ (Out,In)<\/span>", "", "        <span class=\"tk\">return<\/span> dX", "", "    <span class=\"tk\">def<\/span> <span class=\"tf\">up