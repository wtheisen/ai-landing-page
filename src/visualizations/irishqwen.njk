const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const gh = (f,s,e) => `${D.repo}/blob/${D.commit}/irishQwen/${f}#L${s}-L${e}`;

// diagram wiring
const hits = [...document.querySelectorAll('#dia .hit')];
hits.forEach(g => {
  const c = D.components[g.dataset.c];
  g.setAttribute('role','button'); g.setAttribute('tabindex','0');
  if (!g.getAttribute('aria-label')) g.setAttribute('aria-label', c.title);
  g.dataset.file = c.focus.file;
  g.addEventListener('click', () => open(g.dataset.c, g));
  g.addEventListener('keydown', e => { if (e.key==='Enter'||e.key===' ') { e.preventDefault(); open(g.dataset.c, g); } });
});

// component index (mirrors the slide's legend)
$('#meta').innerHTML = D.source==='solutions'
  ? `Full solution code from the <code>solutions_irishQwen</code> folder, with every exercise filled in. Same structure as <a href="${D.repo}" target="_blank" rel="noopener">wtheisen/irishQwen</a>.`
  : `Code from <a href="${D.repo}" target="_blank" rel="noopener">wtheisen/irishQwen</a> at <code>${D.commit.slice(0,7)}</code>. Methods marked <span class="xb" style="margin:0">exercise</span> are left for you to write.`;
// card
const card = $('#card'), persp = $('#persp'), scrim = $('#scrim');
let cur = null, srcEl = null, tabI = 0, anim = null;

function target(){
  const vw = innerWidth, vh = innerHeight, m = vw < 600 ? 8 : 24;
  const w = Math.min(1060, vw - m*2), h = Math.min(820, vh - m*2);
  return {left:(vw-w)/2, top:(vh-h)/2, width:w, height:h};
}
const px = r => ({left:r.left+'px', top:r.top+'px', width:r.width+'px', height:r.height+'px'});

let curFile = null, tabs = [], shownFile = null, rows = [], spyMuteUntil = 0;

// Tabs for a file = its AST outline (classes, methods, functions). If the card's focus
// isn't exactly one of those nodes, a gold "focus" tab for it goes first.
function tabsFor(file){
  const c = D.components[cur], f = c.focus;
  const nodes = D.files[file].outline.map(n => ({...n, file}));
  if (f.file === file && !nodes.some(n => n.start === f.start && n.end === f.end))
    nodes.unshift({label: f.label, type: 'focus', file, start: f.start, end: f.end});
  return nodes;
}
function initialTab(){
  const f = D.components[cur].focus;
  if (curFile !== f.file) return Math.max(0, tabs.findIndex(t => t.type === 'class'));
  return tabs.findIndex(t => t.start === f.start && t.end === f.end);
}

function fill(cid){
  const c = D.components[cid];
  cur = cid; shownFile = null;
  hits.forEach(g => g.classList.toggle('is-active', g.dataset.c===cid));
  const kv = `var(${KIND_VAR[c.kind]})`, sv = `var(${STROKE_VAR[c.kind]})`;
  $('#c-front').style.background = kv; document.querySelector('.card .back').style.borderColor = sv; $('#c-front-l').textContent = c.title;
  $('#c-sw').style.background = kv; $('#c-sw').style.borderColor = sv;
  $('#c-title').textContent = c.title;
  $('#c-note').textContent = c.note;
  navStack = [];
  renderFilesBar();
  showFile(c.focus.file);
}

let navStack = [];
const FILE_KIND = Object.fromEntries(D.fileOrder);
const dot = f => `<span class="dot" style="background:var(${STROKE_VAR[FILE_KIND[f]]})"></span>`;
const nameOf = t => t.type === 'method' ? `${t.parent}.${t.label}` : t.type === 'class' ? t.label : t.type === 'func' ? t.label + '()' : t.label;
// The outline node that stands for the current selection (a focus range maps to its enclosing method)
function selNode(){
  const t = tabs[tabI];
  return t.type === 'focus' ? (tabs[nodeAt(t.start)] || t) : t;
}
const keyOf = (file, t) => `${file}:${t.start}:${t.end}`;

// Files row: all files in data-flow order; the current file is solid gold,
// files the selected block calls into or is called from get a dashed gold ring.
function renderFilesBar(){
  const bar = $('#c-files'); bar.innerHTML = '<span class="lab">Files</span>';
  D.fileOrder.forEach(([fn]) => {
    const b = document.createElement('button');
    b.className = 'fbtn'; b.dataset.file = fn;
    b.innerHTML = dot(fn) + fn;
    b.addEventListener('click', () => goToFile(fn));
    bar.appendChild(b);
  });
}
function renderConn(){
  const n = selNode(), g = D.graph[keyOf(curFile, n)] || {calls: [], by: []};
  // file ring states
  const rel = new Map();
  g.calls.forEach(k => { const f = k.split(':')[0]; if (f !== curFile) rel.set(f, (rel.get(f) ? rel.get(f) + ', ' : '') + 'called'); });
  g.by.forEach(k => { const f = k.split(':')[0]; if (f !== curFile) rel.set(f, (rel.get(f) ? rel.get(f) + ', ' : '') + 'caller'); });
  $('#c-files').querySelectorAll('.fbtn').forEach(b => {
    const f = b.dataset.file;
    b.setAttribute('aria-current', f === curFile);
    b.classList.toggle('rel', rel.has(f));
    b.title = f === curFile ? 'Current file' : rel.has(f) ? `${nameOf(n)} connects here (${rel.get(f)})` : 'Open ' + f;
  });
  const bar = $('#c-files'), cb = bar.querySelector('[aria-current="true"]');
  if (cb){ const l = cb.offsetLeft - bar.offsetLeft; if (l < bar.scrollLeft || l + cb.offsetWidth > bar.scrollLeft + bar.clientWidth) bar.scrollLeft = l - 60; }

  const chip = k => { const [f, a, z] = k.split(':'); return `<button class="cchip" data-go="${k}" title="Go to ${D.graph[k].n} (${f})">${dot(f)}${D.graph[k].n}</button>`; };
  let h = '';
  if (navStack.length){
    h += '<div class="grp"><span class="lab">Path</span>' +
      navStack.map((e,i) => `<button class="crumb" data-crumb="${i}" title="Back to ${e.name} (${e.file})">${e.name}</button><span class="sepc">›</span>`).join('') +
      `<span class="crumb here">${nameOf(n)}</span></div>`;
  }
  h += '<div class="grp"><span class="lab">Called from</span>' + (g.by.length ? g.by.map(chip).join('') : '<span class="none">nothing in the repo</span>') + '</div>';
  h += '<div class="grp"><span class="lab">Calls</span>' + (g.calls.length ? g.calls.map(chip).join('') : '<span class="none">no repo functions</span>') + '</div>';
  $('#c-conn').innerHTML = h;
}
$('#c-conn').addEventListener('click', e => {
  const c = e.target.closest('[data-go]');
  if (c){ const [f, a, z] = c.dataset.go.split(':'); goTo(f, +a, +z); return; }
  const cr = e.target.closest('[data-crumb]');
  if (cr){ const i = +cr.dataset.crumb, to = navStack[i]; navStack = navStack.slice(0, i); showFile(to.file, {start: to.start, end: to.end}); }
});

function pushHere(){
  const here = tabs[tabI], owner = selNode();
  navStack.push({file: curFile, start: here.start, end: here.end, name: nameOf(owner)});
}
// Jump to a definition (file:start:end), remembering where we came from
function goTo(file, start, end){ pushHere(); showFile(file, {start, end}); }
function goToFile(fn){ if (fn === curFile) return; pushHere(); showFile(fn); }
function goBack(){
  const prev = navStack.pop();
  if (prev) showFile(prev.file, {start: prev.start, end: prev.end});
}

function showFile(fn, want){
  curFile = fn; tabs = tabsFor(fn);
  const bar = $('#c-tabs'); bar.innerHTML = '';
  tabs.forEach((t,i) => {
    if (t.type === 'class' && i > 0) bar.insertAdjacentHTML('beforeend', '<span class="sep"></span>');
    const b = document.createElement('button');
    b.className = 'tab' + (t.type === 'class' ? ' cls' : '') + (t.type === 'focus' ? ' focus-t' : '');
    b.setAttribute('role','tab'); b.dataset.i = i;
    if (t.type === 'class') b.innerHTML = `<span class="kw">class</span>${t.label}`;
    else b.textContent = t.type === 'func' ? t.label + '()' : t.label;
    b.title = `lines ${t.start}–${t.end}`;
    b.addEventListener('click', () => { tabI = i; renderTab(); });
    bar.appendChild(b);
  });
  spyRanges(fn);
  const wi = want ? tabs.findIndex(t => t.start === want.start && t.end === want.end) : -1;
  tabI = wi >= 0 ? wi : initialTab();
  renderTab();
}

// For the scroll spy only: stretch each node down to the line before its next sibling
// (or to its parent's end), so blank lines between methods never fall back to the class.
function spyRanges(fn){
  const nLines = D.files[fn].html.length;
  const nodes = tabs.filter(t => t.type !== 'focus');
  nodes.forEach(t => {
    const parentEnd = t.parent ? (nodes.find(p => p.type === 'class' && p.label === t.parent && p.depth === t.depth - 1)?.end ?? nLines) : nLines;
    const next = nodes.filter(o => o !== t && o.depth === t.depth && o.parent === t.parent && o.start > t.start)
                      .reduce((a,o) => (!a || o.start < a.start) ? o : a, null);
    t.spyStart = t.start;
    t.spyEnd = next ? next.start - 1 : parentEnd;
  });
}

// Select tab tabI: render its file if needed, move the border, optionally scroll to it.
function renderTab(scroll = true){
  const t = tabs[tabI], f = D.files[t.file];
  const code = $('#c-code');
  const sameFile = t.file === shownFile;
  if (!sameFile){
    const stubStart = new Set(f.stubs.map(s => s[0]));
    code.innerHTML = '<div class="lines">' + f.html.map((h,i) =>
      `<div class="row"><span class="no">${i+1}</span><span class="src">${h||' '}${stubStart.has(i+1)?'<span class="xb">exercise</span>':''}</span></div>`
    ).join('') + '</div><div class="tail" aria-hidden="true"></div><div class="hovbox" id="c-hov" hidden><span></span></div>';
    rows = [...code.firstChild.children]; shownFile = t.file;
  }
  const bar = $('#c-tabs');
  bar.querySelectorAll('.tab').forEach(b => b.setAttribute('aria-selected', +b.dataset.i === tabI));
  const sel = bar.querySelector('.tab[aria-selected="true"]');
  if (sel){ // keep the selected tab visible in the scrolling tab row
    const l = sel.offsetLeft - bar.offsetLeft, r = l + sel.offsetWidth;
    if (l < bar.scrollLeft + 12) bar.scrollLeft = l - 24;
    else if (r > bar.scrollLeft + bar.clientWidth - 12) bar.scrollLeft = r - bar.clientWidth + 24;
  }
  const who = t.type === 'method' ? `${t.parent}.${t.label}` : t.type === 'class' ? `class ${t.label}` : t.type === 'func' ? `${t.label}()` : t.label;
  $('#c-path').innerHTML = (D.source==='solutions'
    ? `solutions_irishQwen/irishQwen/${t.file}`
    : `irishQwen/${t.file}`) + ` · <b>${who}</b> · lines ${t.start}–${t.end}` +
    (D.source==='solutions' ? '' : ` · <a href="${gh(t.file,t.start,t.end)}" target="_blank" rel="noopener">open on GitHub ↗</a>`);
  renderConn();
  rows.forEach((r,i) => { r.classList.toggle('hot', i+1>=t.start && i+1<=t.end); r.classList.toggle('hot-top', i+1===t.start); r.classList.toggle('hot-bot', i+1===t.end); });
  code.classList.toggle('only', $('#c-only').checked);
  if (scroll) requestAnimationFrame(() => scrollToHot(sameFile && !reduce));
}
function scrollToHot(smooth = false){
  const code = $('#c-code'), first = code.querySelector('.row.hot');
  if (!first) return;
  const top = Math.max(0, first.offsetTop - 24);
  if (smooth) tweenTo(top);
  else { stopScrollAnims(); spyMuteUntil = performance.now() + 150; code.scrollTop = top; code.scrollLeft = 0; }
}

// ---- Scrolling in the code pane: slower, eased jumps and damped wheel scrolling ----
const WHEEL_SPEED = 0.55;   // fraction of the browser's normal wheel distance
const WHEEL_EASE = 0.16;    // how quickly the pane catches up to the wheel target each frame
let tween = 0, wheelTarget = null, wheelRaf = 0;
function stopScrollAnims(){
  cancelAnimationFrame(tween); tween = 0;
  cancelAnimationFrame(wheelRaf); wheelRaf = 0; wheelTarget = null;
}
const easeInOut = p => p < .5 ? 4*p*p*p : 1 - Math.pow(-2*p + 2, 3) / 2;
function tweenTo(top){
  const code = $('#c-code');
  stopScrollAnims();
  const from = code.scrollTop, d = top - from;
  if (reduce || Math.abs(d) < 2){ code.scrollTop = top; return; }
  const dur = Math.min(1200, Math.max(650, 500 + Math.abs(d) * 0.3));
  const t0 = performance.now();
  spyMuteUntil = Infinity;               // the spy waits until the jump lands
  const step = now => {
    const p = Math.min(1, (now - t0) / dur);
    code.scrollTop = from + d * easeInOut(p);
    if (p < 1) tween = requestAnimationFrame(step);
    else { tween = 0; spyMuteUntil = performance.now() + 80; }
  };
  tween = requestAnimationFrame(step);
}
$('#c-code').addEventListener('wheel', e => {
  if (e.ctrlKey || Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;   // pinch-zoom and sideways scrolling stay native
  const code = e.currentTarget;
  e.preventDefault();
  if (tween){ cancelAnimationFrame(tween); tween = 0; }
  spyMuteUntil = 0;
  const unit = e.deltaMode === 1 ? 18 : e.deltaMode === 2 ? code.clientHeight : 1;
  const max = code.scrollHeight - code.clientHeight;
  const base = wheelTarget ?? code.scrollTop;
  wheelTarget = Math.max(0, Math.min(max, base + e.deltaY * unit * WHEEL_SPEED));
  if (reduce){ code.scrollTop = wheelTarget; wheelTarget = null; return; }
  if (!wheelRaf){
    const step = () => {
      const diff = wheelTarget - code.scrollTop;
      if (Math.abs(diff) < 0.5){ code.scrollTop = wheelTarget; wheelTarget = null; wheelRaf = 0; return; }
      code.scrollTop += diff * WHEEL_EASE;
      wheelRaf = requestAnimationFrame(step);
    };
    wheelRaf = requestAnimationFrame(step);
  }
}, {passive:false});

// Scroll spy: select the tightest outline node around the reading line (a method beats its class).
function spy(){
  if (!cur || $('#c-only').checked || performance.now() < spyMuteUntil || !rows.length) return;
  const code = $('#c-code'), rowH = rows[0].offsetHeight || 1;
  const line = Math.floor((code.scrollTop + code.clientHeight * 0.3 - rows[0].offsetTop) / rowH) + 1;
  let best = -1, bestSpan = Infinity;
  tabs.forEach((t,i) => {
    if (t.type === 'focus' || line < t.spyStart || line > t.spyEnd) return;
    const span = t.spyEnd - t.spyStart;
    if (span < bestSpan){ best = i; bestSpan = span; }
  });
  // Only switch when the new node clearly owns the reading line
  if (best >= 0 && best !== tabI){ tabI = best; renderTab(false); }
}
// Hover: outline the code block under the pointer (if it isn't the selected one); click selects it.
let hovI = -1;
function nodeAt(line){
  let best = -1, bestSpan = Infinity;
  tabs.forEach((t,i) => {
    if (t.type === 'focus' || line < t.start || line > t.end) return;
    if (t.end - t.start < bestSpan){ best = i; bestSpan = t.end - t.start; }
  });
  return best;
}
function hideHover(){ hovI = -1; const h = $('#c-hov'); if (h) h.hidden = true; $('#c-code').classList.remove('pick'); }
function showHover(i){
  const t = tabs[i], h = $('#c-hov'), code = $('#c-code');
  const top = rows[t.start-1], bot = rows[t.end-1], src = top.querySelector('.src');
  const left = src.offsetLeft, width = code.firstChild.offsetWidth - 14 - left;
  Object.assign(h.style, {top:top.offsetTop+'px', left:left+'px', width:width+'px', height:(bot.offsetTop + bot.offsetHeight - top.offsetTop)+'px'});
  h.firstChild.textContent = (t.type === 'class' ? 'class ' + t.label : t.type === 'func' ? t.label + '()' : t.label) + ' · click to select';
  h.hidden = false; hovI = i; code.classList.add('pick');
}
$('#c-code').addEventListener('mousemove', e => {
  if (!cur || $('#c-only').checked) return hideHover();
  const row = e.target.closest('.row');
  if (!row) return hideHover();
  const i = nodeAt(rows.indexOf(row) + 1);
  if (i < 0 || i === tabI) return hideHover();
  if (i !== hovI) showHover(i);
});
$('#c-code').addEventListener('mouseleave', hideHover);
$('#c-code').addEventListener('click', e => {
  const go = e.target.closest('.go');
  if (go && go.closest('.row.hot')){
    e.preventDefault();
    const [f, a, b] = go.dataset.go.split(':');
    hideHover(); goTo(f, +a, +b);
    return;
  }
  if (hovI < 0) return;
  const sel = getSelection();
  if (sel && !sel.isCollapsed) return;   // dragging to select text, not picking a block
  tabI = hovI; hideHover(); renderTab(true);
});

let spyQueued = false;
$('#c-code').addEventListener('scroll', () => {
  hideHover();
  if (spyQueued) return; spyQueued = true;
  requestAnimationFrame(() => { spyQueued = false; spy(); });
}, {passive:true});

const wrap = document.querySelector('.wrap'), back = document.querySelector('.card .back');

// ---- Zooming into a block ----------------------------------------------------------
// A copy of the diagram SVG sits over the page and zooms by changing its viewBox, so it
// re-renders crisp every frame (no scaled bitmaps). Scale grows exponentially (steady
// perceived speed) while the block glides to the screen center. The code view is clipped
// to the block's on-screen shape, which is computed, not measured, each frame.
const zl = $('#zoomlayer'), zlBg = zl.querySelector('.zl-bg');
const VBW = 476, VBH = 545;
const clamp01 = x => Math.max(0, Math.min(1, x));
const easeInOutCubic = p => p < .5 ? 4*p*p*p : 1 - Math.pow(-2*p + 2, 3) / 2;
// CSS-style cubic-bezier easing (x1, y1, x2, y2), solved with Newton steps
function bezier(x1, y1, x2, y2){
  const cx = 3*x1, bx = 3*(x2-x1) - cx, ax = 1 - cx - bx, cy = 3*y1, by = 3*(y2-y1) - cy, ay = 1 - cy - by;
  const X = t => ((ax*t + bx)*t + cx)*t, Y = t => ((ay*t + by)*t + cy)*t, dX = t => (3*ax*t + 2*bx)*t + cx;
  return p => { let t = p; for (let i = 0; i < 6; i++){ const d = dX(t); if (Math.abs(d) < 1e-6) break; t -= (X(t) - p) / d; } return Y(Math.max(0, Math.min(1, t))); };
}
const zoomEase = bezier(.45, .05, .25, 1);     // gets moving right away, long gentle arrival
const smooth = (a, b, x) => { const t = clamp01((x - a) / (b - a)); return t * t * (3 - 2 * t); };
const easeOutCubic = p => 1 - Math.pow(1 - p, 3);
const seg = (t, a, b) => clamp01((t - a) / (b - a));      // progress of t inside [a, b]

function zoomPlan(el){
  const R = $('#dia').getBoundingClientRect(), vw = innerWidth, vh = innerHeight;
  const k0 = Math.min(R.width / VBW, R.height / VBH);              // px per unit, as drawn
  const ox = R.left + (R.width - VBW * k0) / 2, oy = R.top + (R.height - VBH * k0) / 2;
  const bb = el.getBBox();                                         // block, in diagram units
  const bc = {x: bb.x + bb.width / 2, y: bb.y + bb.height / 2};
  const shape = el.querySelector('rect, circle');
  const isCircle = !!shape && shape.tagName === 'circle', rx = +(shape && shape.getAttribute('rx')) || 4;
  // final zoom: the block's shape must cover the whole screen, corners included, so nothing
  // snaps when the clip is removed (a rounded corner bites ~0.3·r into the diagonal)
  const k1 = (isCircle ? Math.hypot(vw, vh) / Math.min(bb.width, bb.height)
                       : Math.max(vw / (bb.width - 0.6 * rx), vh / (bb.height - 0.6 * rx))) * 1.03;
  return {vw, vh, k0, k1, bb, bc,
    s0: {x: ox + bc.x * k0, y: oy + bc.y * k0},                    // block center on screen, at rest
    s1: {x: vw / 2, y: vh / 2},
    circle: isCircle, rx};
}
// Camera at zoom progress z (0 = page as drawn, 1 = inside the block)
function camera(P, z){
  const k = P.k0 * Math.pow(P.k1 / P.k0, z);
  const c = {x: P.s0.x + (P.s1.x - P.s0.x) * z, y: P.s0.y + (P.s1.y - P.s0.y) * z};
  return {k, c, vb: [P.bc.x - c.x / k, P.bc.y - c.y / k, P.vw / k, P.vh / k]};
}
function roundRect(x, y, w, h, r){
  r = Math.max(0, Math.min(r, w/2, h/2));
  return `path('M${x+r},${y} H${x+w-r} A${r},${r} 0 0 1 ${x+w},${y+r} V${y+h-r} A${r},${r} 0 0 1 ${x+w-r},${y+h} H${x+r} A${r},${r} 0 0 1 ${x},${y+h-r} V${y+r} A${r},${r} 0 0 1 ${x+r},${y} Z')`;
}
let zsvg = null, zRaf = 0;
function mountZoomSvg(){
  if (zsvg) zsvg.remove();
  zsvg = $('#dia').cloneNode(true);
  zsvg.removeAttribute('id'); zsvg.setAttribute('preserveAspectRatio', 'none');
  zsvg.querySelectorAll('[tabindex]').forEach(n => n.removeAttribute('tabindex'));
  zl.appendChild(zsvg);
}
// Draw one frame of the timeline. t runs 0 → T going in; the same frames play backwards going out.
const T = 1100;
function drawZoom(P, t){
  const z = zoomEase(seg(t, 0, T));
  const cam = camera(P, z);
  zsvg.setAttribute('viewBox', cam.vb.map(v => v.toFixed(3)).join(' '));
  // the page around the diagram dissolves into the diagram's own background early on
  const pageFade = smooth(0, 380, t);
  wrap.style.opacity = 1 - pageFade; zlBg.style.opacity = pageFade;
  // the block on screen
  const w = P.bb.width * cam.k, h = P.bb.height * cam.k;
  const x = cam.c.x - w / 2, y = cam.c.y - h / 2;
  const r = P.circle ? Math.min(w, h) / 2 : P.rx * cam.k;
  card.style.clipPath = roundRect(x, y, w, h, r);
  // Fades follow the zoom itself (same pace for every block, small or large): the block's
  // color washes over its label early, and the code rises inside it through the middle of the zoom
  $('#c-front').style.opacity = smooth(0.04, 0.26, z);
  const c = smooth(0.14, 0.88, z);
  back.style.opacity = c; back.style.transform = `scale(${0.975 + 0.025 * c})`;
}
function runZoom(P, dir, done){
  cancelAnimationFrame(zRaf);
  const t0 = performance.now();
  const step = now => {
    const e = Math.min(T, now - t0);
    drawZoom(P, dir > 0 ? e : T - e);
    if (e < T) zRaf = requestAnimationFrame(step); else { zRaf = 0; done(); }
  };
  zRaf = requestAnimationFrame(step);
}

function open(cid, el){
  if (cur && !persp.hidden){ go(cid, el); return; }
  if (anim) return;
  srcEl = el; fill(cid);
  document.body.style.overflow = 'hidden'; document.documentElement.style.overflow = 'hidden';
  if (reduce){
    persp.hidden = false; $('#c-front').style.opacity = 1; back.style.opacity = 1; wrap.style.visibility = 'hidden';
    settle(); return;
  }
  const P = zoomPlan(el);
  document.body.classList.add('zooming');
  mountZoomSvg(); zl.hidden = false; persp.hidden = false;
  drawZoom(P, 0);
  back.style.opacity = 0.001;                 // painted (so its first real frame is free) but invisible
  anim = true;
  // give the browser two frames to lay out and paint the code view before anything moves
  requestAnimationFrame(() => requestAnimationFrame(() => runZoom(P, +1, () => {
    document.body.classList.remove('zooming');
    card.style.clipPath = ''; back.style.transform = '';
    zl.hidden = true; wrap.style.visibility = 'hidden';
    settle();
  })));
}
function settle(){ anim = null; scrollToHot(); $('#c-close').focus({preventScroll: true}); }

function close(){
  if (persp.hidden || anim) return;
  const el = document.querySelector(`#dia .hit[data-c="${cur}"]`) || srcEl;
  const done = () => {
    document.body.classList.remove('zooming');
    persp.hidden = true; zl.hidden = true;
    card.style.clipPath = ''; back.style.transform = '';
    $('#c-front').style.opacity = ''; back.style.opacity = '';
    wrap.style.opacity = ''; wrap.style.visibility = '';
    hits.forEach(g => g.classList.remove('is-active'));
    document.body.style.overflow = ''; document.documentElement.style.overflow = '';
    cur = null; anim = null;
    if (el && el.focus) el.focus({preventScroll: true});
  };
  if (reduce){ done(); return; }
  stopScrollAnims();
  // exit through the block we're in now (it may differ from the one we entered through)
  hits.forEach(g => g.classList.toggle('is-active', g === el));
  wrap.style.visibility = ''; wrap.style.opacity = 0;
  const P = zoomPlan(el);
  document.body.classList.add('zooming');
  mountZoomSvg(); zl.hidden = false;
  drawZoom(P, T);
  anim = true;
  runZoom(P, -1, done);
}

// Moving to another block while zoomed in: a quick cross-fade of the code view
function go(cid, el){
  if (anim || cid === cur) return;
  srcEl = el || document.querySelector(`#dia .hit[data-c="${cid}"]`);
  if (reduce){ fill(cid); scrollToHot(); return; }
  anim = back.animate([{opacity: 1}, {opacity: 0}], {duration: 140, easing: 'ease-in', fill: 'forwards'});
  anim.onfinish = () => {
    fill(cid); scrollToHot();
    const a2 = back.animate([{opacity: 0}, {opacity: 1}], {duration: 200, easing: 'ease-out'});
    anim.cancel(); anim = a2;
    a2.onfinish = () => { anim = null; };
  };
}
function step(d){
  const i = FLOW.indexOf(cur), j = i<0 ? 0 : (i + d + FLOW.length) % FLOW.length;
  go(FLOW[j]);
}

$('#c-close').addEventListener('click', close);
$('#c-next').addEventListener('click', () => step(1));
$('#c-prev').addEventListener('click', () => step(-1));
$('#c-only').addEventListener('change', e => { $('#c-code').classList.toggle('only', e.target.checked); scrollToHot(); });
$('#c-copy').addEventListener('click', () => {
  const t = tabs[tabI];
  const text = [...$('#c-code').querySelectorAll('.row.hot .src')].map(s => {
    const c = s.cloneNode(true); c.querySelectorAll('.xb').forEach(x=>x.remove()); return c.textContent.replace(/ $/,'');
  }).join('\n');
  const toast = $('#c-toast');
  const show = msg => { toast.textContent = msg; toast.classList.add('on'); setTimeout(()=>toast.classList.remove('on'),1400); };
  try { navigator.clipboard.writeText(text).then(()=>show(`Copied lines ${t.start}–${t.end}`), ()=>show('Copy blocked: select the code instead')); }
  catch(e){ show('Copy blocked: select the code instead'); }
});
addEventListener('keydown', e => {
  if (persp.hidden) return;
  if (e.key==='Escape') close();
  else if (e.key==='ArrowLeft' && e.altKey){ e.preventDefault(); goBack(); }
  else if (e.key==='ArrowRight' && !e.target.closest('.code')) step(1);
  else if (e.key==='ArrowLeft' && !e.target.closest('.code')) step(-1);
});

</script>

</body>
