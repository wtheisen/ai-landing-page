---
layout: base.njk
title: Backpropagation Visualizer
icon: fa-retweet
navigation:
  - name: "Home"
    link: "index.html"
    icon: "fa-home"
permalink: "backpropagation.html"
extraScript: "static/js/backpropagation.js"
tags: visualization
cardTitle: "Backpropagation"
cardIcon: fa-retweet
cardDescription: "Trace a prediction forward, follow gradients backward, inspect every chain-rule factor, and watch gradient descent update each weight."
cardTags:
  - Deep Learning
  - Training
cardHaystack: "backpropagation backprop gradient chain rule neural network training loss vanishing gradient"
cardOrder: 19
cardImage: static/img/vis_cards/backpropagation.png
---

{% from "components/legend.njk" import legend %}
{% from "components/info-tabs.njk" import infoTabs %}

<link rel="stylesheet" href="static/css/backpropagation.css">

<div class="row" id="main-content">
    {% include "components/share-button.njk" %}

    <!-- Left Column: Architecture + Parameter Inspector + Training History -->
    <div class="col-md-7">
        <div class="panel panel-default">
            <div class="panel-heading">
                <div class="panel-heading-content">
                    <div class="btn-group btn-group-sm bp-view-toggle" role="group" aria-label="Network value view">
                        <button type="button" class="btn btn-default" id="btn-view-forward">
                            <i class="fa fa-arrow-right"></i> Activations
                        </button>
                        <button type="button" class="btn btn-default active" id="btn-view-gradient">
                            <i class="fa fa-arrow-left"></i> Gradients
                        </button>
                    </div>
                    <div class="bp-header-badges">
                        <span class="viz-badge" id="bp-output-badge">ŷ = —</span>
                        <span class="viz-badge" id="bp-loss-badge">L = —</span>
                        <span class="viz-badge complete" id="pass-badge">Ready</span>
                    </div>
                </div>
            </div>
            <div class="panel-body canvas-panel-body">
                <div class="bp-pass-strip" aria-label="Backpropagation phases">
                    <span class="bp-pass-stage complete" id="bp-stage-forward">
                        <i class="fa fa-arrow-right"></i> 1. Forward
                    </span>
                    <span class="bp-pass-arrow">→</span>
                    <span class="bp-pass-stage complete" id="bp-stage-loss">
                        <i class="fa fa-bullseye"></i> 2. Loss
                    </span>
                    <span class="bp-pass-arrow">→</span>
                    <span class="bp-pass-stage complete" id="bp-stage-backward">
                        <i class="fa fa-arrow-left"></i> 3. Backward
                    </span>
                    <span class="bp-pass-arrow">→</span>
                    <span class="bp-pass-stage" id="bp-stage-update">
                        <i class="fa fa-pencil"></i> 4. Update
                    </span>
                </div>
                <div class="canvas-wrapper bp-network-wrapper">
                    <canvas id="network-canvas" width="560" height="390"
                            aria-label="Interactive 2-3-1 neural network. Click a connection to inspect its gradient."></canvas>
                    <div class="bp-canvas-hint">
                        <i class="fa fa-mouse-pointer"></i> Click any connection to inspect its chain rule
                    </div>
                    <div class="bp-canvas-tooltip" id="bp-canvas-tooltip" role="tooltip"></div>
                </div>
            </div>
            <div class="panel-footer legend-footer">
                {{ legend(
                    items=[
                        {class: 'bp-input-node', label: 'Input'},
                        {class: 'bp-hidden-node', label: 'Hidden'},
                        {class: 'bp-output-node', label: 'Output'},
                        {class: 'bp-positive-edge', label: 'Positive Weight', type: 'line'},
                        {class: 'bp-negative-edge', label: 'Negative Weight', type: 'line'},
                        {class: 'bp-gradient-flow', label: 'Gradient Magnitude', type: 'line'}
                    ]
                ) }}
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading">
                <div class="panel-heading-content">
                    <span class="panel-title-text">
                        <i class="fa fa-table"></i> Parameter Gradients
                    </span>
                    <span class="bp-selected-label" id="bp-selected-label">Selected: h₁ → ŷ</span>
                </div>
            </div>
            <div class="panel-body compact-panel">
                <div class="bp-gradient-table-wrap">
                    <table class="table table-condensed table-striped bp-gradient-table">
                        <thead>
                            <tr>
                                <th>Connection</th>
                                <th class="text-right">Weight</th>
                                <th class="text-right">∂L/∂w</th>
                                <th class="text-right">−η∂L/∂w</th>
                                <th class="text-right">After update</th>
                            </tr>
                        </thead>
                        <tbody id="bp-gradient-tbody"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading">
                <div class="panel-heading-content">
                    <span class="panel-title-text"><i class="fa fa-line-chart"></i> Training History</span>
                    <span class="bp-history-summary" id="bp-history-summary">Initial loss</span>
                </div>
            </div>
            <div class="panel-body canvas-panel-body">
                <div class="canvas-wrapper bp-loss-wrapper">
                    <canvas id="loss-canvas" width="560" height="175"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: one tabbed information panel -->
    <div class="col-md-5">
        {{ infoTabs(
            tabs=[
                {id: 'about', icon: 'fa-info-circle', label: 'About', active: true, content: '
                    <h4><i class="fa fa-retweet"></i> Backpropagation</h4>
                    <p>
                        Backpropagation assigns <strong>credit or blame</strong> for the prediction error
                        to every weight in a neural network. It works backward from the loss, multiplying
                        local derivatives with the chain rule.
                    </p>
                    <h4><i class="fa fa-eye"></i> What This View Shows</h4>
                    <ul class="interaction-list">
                        <li><strong>Activations view</strong> traces values from inputs to prediction</li>
                        <li><strong>Gradients view</strong> reverses the flow and colors connections by |∂L/∂w|</li>
                        <li><strong>Click a connection</strong> to reveal every factor in its chain rule</li>
                        <li><strong>Parameter table</strong> compares gradients and proposed weight updates</li>
                        <li><strong>Gradient check</strong> verifies the analytic derivative numerically</li>
                    </ul>
                    <h4><i class="fa fa-lightbulb-o"></i> Try This</h4>
                    <p class="bp-callout">
                        Switch the weight preset from <strong>Balanced</strong> to <strong>Saturated</strong>.
                        With sigmoid or tanh, activation derivatives shrink and gradients nearly disappear.
                    </p>
                '},
                {id: 'algorithm', icon: 'fa-book', label: 'Algorithm', content: '
                    <h4><i class="fa fa-arrow-right"></i> Forward Pass</h4>
                    <ol class="algorithm-steps">
                        <li>Each hidden neuron computes <code>zⱼ = Σᵢ wⱼᵢxᵢ + bⱼ</code></li>
                        <li>Apply the activation: <code>aⱼ = f(zⱼ)</code></li>
                        <li>The output neuron combines hidden activations to produce <code>ŷ</code></li>
                        <li>Measure error with <code>L = ½(t − ŷ)²</code></li>
                    </ol>
                    <h4><i class="fa fa-arrow-left"></i> Backward Pass</h4>
                    <ol class="algorithm-steps">
                        <li>Start at the loss: <code>∂L/∂ŷ = ŷ − t</code></li>
                        <li>Multiply by the sigmoid output derivative</li>
                        <li>Continue backward through each weight and hidden activation</li>
                        <li>Store one gradient <code>∂L/∂w</code> for every parameter</li>
                    </ol>
                    <h4><i class="fa fa-pencil"></i> Gradient Descent</h4>
                    <div class="math-formula-display">
                        <code>w<sub>new</sub> = w<sub>old</sub> − η · ∂L/∂w</code>
                    </div>
                    <p class="formula-desc">The learning rate η controls how far the weight moves.</p>
                '},
                {id: 'math', icon: 'fa-superscript', label: 'Math', content: '
                    <div class="bp-math-header">
                        <h4><i class="fa fa-link"></i> Selected Chain Rule</h4>
                        <span class="viz-badge" id="bp-math-param-badge">h₁ → ŷ</span>
                    </div>
                    <div class="bp-chain-equation" id="bp-chain-equation"></div>
                    <div class="bp-chain-factors" id="bp-chain-factors"></div>

                    <h4><i class="fa fa-calculator"></i> Weight Update</h4>
                    <table class="table table-condensed metrics-table bp-update-table">
                        <tbody>
                            <tr><td>Current weight</td><td class="metric-value text-right" id="bp-math-weight">—</td></tr>
                            <tr><td>Analytic gradient</td><td class="metric-value text-right" id="bp-math-gradient">—</td></tr>
                            <tr><td>Update −η∂L/∂w</td><td class="metric-value text-right" id="bp-math-delta">—</td></tr>
                            <tr><td>Proposed weight</td><td class="metric-value text-right" id="bp-math-proposed">—</td></tr>
                        </tbody>
                    </table>

                    <h4><i class="fa fa-check-square-o"></i> Numerical Gradient Check</h4>
                    <p class="formula-desc">
                        Perturb the selected weight by ±ε and compare the resulting finite-difference
                        slope with backpropagation.
                    </p>
                    <table class="table table-condensed metrics-table bp-check-table">
                        <tbody>
                            <tr><td>Backprop</td><td class="metric-value text-right" id="bp-check-analytic">—</td></tr>
                            <tr><td>Finite difference</td><td class="metric-value text-right" id="bp-check-numeric">—</td></tr>
                            <tr><td>Relative error</td><td class="metric-value text-right" id="bp-check-error">—</td></tr>
                        </tbody>
                    </table>
                '},
                {id: 'controls', icon: 'fa-sliders', label: 'Controls', content: '
                    <div class="bp-controls-panel">
                        <div class="option-row">
                            <label>Preset:</label>
                            <select id="weight-preset-select" class="form-control input-sm">
                                <option value="balanced" selected>Balanced gradients</option>
                                <option value="saturated">Saturated neurons</option>
                                <option value="small">Tiny weights</option>
                            </select>
                        </div>
                        <div class="option-row">
                            <label>Hidden activation:</label>
                            <select id="activation-select" class="form-control input-sm">
                                <option value="sigmoid" selected>Sigmoid</option>
                                <option value="relu">ReLU</option>
                                <option value="tanh">Tanh</option>
                            </select>
                        </div>
                        <div class="bp-control-divider"></div>
                        <div class="option-row">
                            <label>x<sub>1</sub>:</label>
                            <input type="range" id="x1-slider" min="0" max="1" step="0.01" value="0.50">
                            <span id="x1-value" class="range-value">0.50</span>
                        </div>
                        <div class="option-row">
                            <label>x<sub>2</sub>:</label>
                            <input type="range" id="x2-slider" min="0" max="1" step="0.01" value="0.80">
                            <span id="x2-value" class="range-value">0.80</span>
                        </div>
                        <div class="option-row">
                            <label>Target:</label>
                            <input type="range" id="target-slider" min="0" max="1" step="0.01" value="1.00">
                            <span id="target-value" class="range-value">1.00</span>
                        </div>
                        <div class="option-row">
                            <label>Learning η:</label>
                            <input type="range" id="lr-slider" min="0.001" max="1.0" step="0.001" value="0.50">
                            <span id="lr-value" class="range-value">0.500</span>
                        </div>
                        <div class="bp-control-divider"></div>
                        <div class="bp-action-grid">
                            <button id="btn-forward" class="btn btn-sm btn-info">
                                <i class="fa fa-arrow-right"></i> Forward
                            </button>
                            <button id="btn-backward" class="btn btn-sm btn-warning">
                                <i class="fa fa-arrow-left"></i> Backward
                            </button>
                            <button id="btn-train-step" class="btn btn-sm btn-success">
                                <i class="fa fa-step-forward"></i> Train Step
                            </button>
                            <button id="btn-train-many" class="btn btn-sm btn-success">
                                <i class="fa fa-forward"></i> Train ×25
                            </button>
                            <button id="btn-reset" class="btn btn-sm btn-danger bp-reset-button">
                                <i class="fa fa-refresh"></i> Reset
                            </button>
                        </div>
                    </div>
                '},
                {id: 'log', icon: 'fa-terminal', label: 'Log', content: '
                    <table class="table table-condensed metrics-table bp-metrics-table">
                        <tbody>
                            <tr>
                                <td><i class="fa fa-repeat"></i> Step</td>
                                <td class="metric-value text-right" id="metric-step">0</td>
                                <td><i class="fa fa-line-chart"></i> Loss</td>
                                <td class="metric-value text-right" id="metric-loss">—</td>
                            </tr>
                            <tr>
                                <td><i class="fa fa-bullseye"></i> Output</td>
                                <td class="metric-value text-right" id="metric-output">—</td>
                                <td><i class="fa fa-crosshairs"></i> Target</td>
                                <td class="metric-value text-right" id="metric-target">1.00</td>
                            </tr>
                            <tr>
                                <td><i class="fa fa-arrows-v"></i> Max |Grad|</td>
                                <td class="metric-value text-right" id="metric-max-grad">—</td>
                                <td><i class="fa fa-info-circle"></i> Status</td>
                                <td class="metric-value text-right" id="metric-status">Ready</td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="execution-log bp-computation-log" id="computation-log">
                        <div class="log-entry log-info">
                            <span class="log-icon"><i class="fa fa-info-circle"></i></span>
                            <span class="log-message">Initial forward and backward passes are ready. Click a connection to inspect it.</span>
                        </div>
                    </div>
                '}
            ]
        ) }}
    </div>
</div>
